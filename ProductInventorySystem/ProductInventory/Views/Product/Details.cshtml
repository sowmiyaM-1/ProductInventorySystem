@model ProductInventory.Models.Product

@{
    ViewData["Title"] = "Details";
}

<div class="col-md-8">
    <h4>Details: Product</h4>
    <hr />
    <table class="BlueGreen">
    <tr><th>Id</th><td>@Model.Id</td></tr>
    <tr><th>Name</th><td>@Model.Name</td></tr>
    <tr><th>Description</th><td>@Model.Description</td></tr>
     <tr><th>Quantity</th><td>@Model.Quantity</td></tr>
    <tr><th>Price</th><td>@Model.Price</td></tr>
</table>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
